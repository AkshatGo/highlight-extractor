# ============================================================
# Highlight Extraction Service — Environment Configuration
# ============================================================
# Copy to .env and customize for your deployment.
# All values shown are the defaults.
# ============================================================

# --- Server ---
HOST=0.0.0.0
PORT=8000
WORKERS=2
LOG_LEVEL=INFO
RELOAD=false

# --- CORS (comma-separated, or * for all) ---
CORS_ORIGINS=*

# --- Upload Limits ---
MAX_UPLOAD_MB=500
MAX_AUDIO_DURATION_S=14400

# --- Artifact Store ---
ARTIFACT_STORE=/tmp/highlight_artifacts

# --- Scoring Weights (optional, uses config/scoring_weights.yaml by default) ---
# SCORING_WEIGHTS=config/scoring_weights.yaml

# --- Model Configuration ---
WHISPER_MODEL=base
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

# HuggingFace token — REQUIRED for diarization.
# pyannote models are gated: accept the terms at
# https://huggingface.co/pyannote/speaker-diarization-3.1 (and the embedded
# segmentation + wespeaker models it links to), then paste a token from
# https://huggingface.co/settings/tokens here.
HF_TOKEN=

# --- Keyword Presets ---
# Available: default, tech, comedy, news, true_crime, interview
KEYWORD_PRESET=default

# --- Webhooks ---
# Optional: URL to POST to on job completion/failure
# WEBHOOK_URL=https://your-server.com/webhook
WEBHOOK_URL=

# --- Pipeline ---
PIPELINE_TIMEOUT=7200
